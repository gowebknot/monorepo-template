<%!- filter replace("# Monorepo Template", "# " ~ project_name)
  | replace('- `core/create-mono-stack`: source-only npm launcher and Copier tests\n', "")
  | regex_replace('(?s)## Creating a project.*?(?=## Structure)', '## Template updates\n\nThis project records its Copier source and version in .copier-answers.yml. Run updates from a clean working tree with Python 3.10 or newer:\n\n    python3 -m venv .venv\n    .venv/bin/python -m pip install --requirement requirements/copier.txt\n    .venv/bin/copier update\n\nReview and resolve any reported conflicts, then run just check.\n\n') -!%>
<%!- include "README.md" -!%>
<%!- endfilter -!%>
