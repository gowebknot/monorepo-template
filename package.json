{
  "name": "monorepo-template",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo build",
    "core:test": "node --test core/test/core-packages.test.js",
    "dev": "turbo dev --ui tui",
    "dev:reference": "turbo dev:reference --ui tui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo lint && eslint \"scripts/*.mjs\"",
    "package:create": "node skills/create-minimal-package/scripts/scaffold-package.mjs",
    "prepare": "husky",
    "skills:check": "node scripts/skills.mjs check",
    "skills:create": "node scripts/skills.mjs create",
    "skills:remove": "node scripts/skills.mjs remove",
    "skills:sync": "node scripts/skills.mjs sync",
    "skills:test": "node --test scripts/skills.test.mjs scripts/skill-gate.test.mjs scripts/test-case-coverage-policy.test.mjs scripts/test-planning-policy.test.mjs scripts/test-policy-file-contracts.test.mjs",
    "template:test": "pnpm core:test && pnpm --filter create-mono-stack test",
    "template:test:integration": "pnpm --filter create-mono-stack test:integration",
    "template:update": "node scripts/update-template.mjs",
    "typecheck": "turbo typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "packageExtensions": {
      "eslint-config-next": {
        "dependencies": {
          "next": "*"
        }
      }
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "node-gyp": "^13.0.1",
    "prettier": "^3.4.2",
    "shadcn": "^4.15.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "yaml": "2.9.0"
  }
}
